# signal-scout app stack env — copy to deploy/.env (gitignored) on the prod host,
# or set these as the Portainer stack-level environment instead.
# Never commit the real .env.

# Image tag pulled from Harbor (set by CI / rollback).
IMAGE_TAG=latest

ENV=PRODUCTION
SECRET_KEY=replace-me-with-a-random-64-char-string

# Email + OAuth (secrets — keep out of git, live in Portainer stack env).
SENDGRID_API_KEY=replace-me
GOOGLE_OAUTH_CLIENT_ID=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GITHUB_OAUTH_CLIENT_ID=replace-me
GITHUB_OAUTH_CLIENT_SECRET=replace-me

# Prometheus scrape secret — same value as the observability stack.
METRICS_BEARER_TOKEN=replace-me

# Flask-Limiter defaults.
DEFAULT_RATE_LIMIT=16 per minute

# Rate-limit shared storage. memory:// is per-worker, so under a multi-worker
# gunicorn each worker keeps its own counters and the effective limit is N× too
# loose. Point at the in-stack redis service for accurate, shared enforcement.
# The compose file defaults the app to this; set it here (or in the Portainer
# stack env) only to override — e.g. if redis moves.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
