[Unit]
Description=Signal-Scout monthly UKE stations.db refresh
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/signal-scout-db-refresh.env
ExecStart=/usr/local/bin/signal-scout-db-refresh
TimeoutStartSec=2400
Nice=10
